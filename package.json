{
  "name": "window-host",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @window-host/schema && npm run build -w @window-host/core && npm run build -w @window-host/widgets && npm run build -w @window-host/shell && npm run build -w @window-host/desk",
    "dev": "npm run dev -w @window-host/desk",
    "test": "vitest run",
    "test:arch": "vitest run test/architecture.test.ts test/leak.test.ts",
    "test:e2e": "npm run test:e2e -w @window-host/desk"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
